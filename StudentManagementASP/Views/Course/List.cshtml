@{
    ViewData["Title"] = "Danh sách học phần";
    List<CourseClass> courseClasses = ViewBag.CourseClass as List<CourseClass>;
    int stt = 1;
}
@model StudentManagementASP.Models.Curriculum

@section Links {
    <link rel="stylesheet" href="~/assets/css/studentCourse.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css" integrity="sha512-5Hs3dF2AEPkpNAR7UiOHba+lRSJNeM2ECkwxUIxC1Q/FLycGTbNapWXB4tP889k5T5Ju8fs4b1P5z/iB4nMfSQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />

}

<div class="table-container">
    <table class="table-hover">
        <thead>
            <tr>
                <th>STT</th>
                <th>Mã học phần</th>
                <th>Tên học phần</th>
                <th>Số Tín chỉ</th>
                <th>Số Tiết</th>
                <th>Loại HP</th>
                <th>Điểm danh</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.StudyYear.StudyYearDetails)
            {
                if (item.EndYear.Year > Model.StudyYear.EndYear.Year)
                {
                    break;
                }
                foreach (var hk in item.Semesters)
                {
                    var currentCourse = courseClasses?.Where(x => x.Course.SemesterId == hk.Id).ToList();
                    if (currentCourse != null && currentCourse.Any())
                    {
                        <tr class="semester-header">
                            <td colspan="7" style="text-align: left;">Năm học @item.StartYear.Year - @item.EndYear.Year | @hk.Name</td>
                        </tr>
                        foreach (var course in currentCourse)
                        {
                            <tr>
                                <td>@stt</td>
                                <td>@course.Course.Subject.Code</td>
                                <td>@course.Course.Subject.Name</td>
                                <td>@course.Course.Credits</td>
                                <td>@course.Course.Lesson</td>
                                <td>@course.Course.Type.Name</td>
                                <td>
                                    <a href="@Url.Action("CourseInfo", "Course", new {id = course.Id})" class="btn btn-primary">
                                        <i class="fa-solid fa-eye"></i> 
                                        Chi tiết
                                    </a>
                                </td>
                            </tr>
                            stt++;
                        }
                    }
                    
                }
            }
              
        </tbody>
    </table>
</div>
@section Scripts {

}