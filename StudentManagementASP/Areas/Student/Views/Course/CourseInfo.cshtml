@{
    ViewData["Title"] = "Thông tin học phần";
    string[] dayNames = new string[] { "Chủ Nhật", "Thứ Hai", "Thứ Ba", "Thứ Tư", "Thứ Năm", "Thứ Sáu", "Thứ Bảy" };
    var listJoined = (List<StudentJoinLesson>)ViewBag.StudentJoined;
    int stt = 1;
    Dictionary<string, string> statusDic = new Dictionary<string, string>();
    statusDic["Có mặt"] = "status-present";
    statusDic["Có phép"] = "status-absent";
    statusDic["Không phép"] = "status-absent";
    statusDic["Đi trễ"] = "status-late";

    Dictionary<string, string> statusDisplay = new Dictionary<string, string>();
    statusDisplay["Có mặt"] = "Có mặt";
    statusDisplay["Có phép"] = "Vắng có phép";
    statusDisplay["Không phép"] = "Vắng không phép";
    statusDisplay["Đi trễ"] = "Trễ";
}
@model StudentManagementASP.Models.CourseClass

@section Links{
    <link rel="stylesheet" href="~/assets/css/courseInfo.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css" integrity="sha512-5Hs3dF2AEPkpNAR7UiOHba+lRSJNeM2ECkwxUIxC1Q/FLycGTbNapWXB4tP889k5T5Ju8fs4b1P5z/iB4nMfSQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
}

<div class="info-section">
    <h5>Thông tin học phần: <span style='font-weight: normal;'>(@Model.StartDate.ToShortDateString() - @Model.EndDate.ToShortDateString())</span></h5>
    <table class="info-table">
        <tr>
            <td>Mã HP</td>
            <td>@Model.Subject?.Code</td>
            <td>Tên HP</td>
            <td>@Model.Name</td>
        </tr>
        <tr>
            <td>Số tiết</td>
            <td>@Model.Subject?.DefaultLesson</td>
            <td>Giảng viên</td>
            <td>@Model.Lecturer?.FullName</td>
        </tr>
        <tr>
            <td>Thời gian</td>
            <td>@Model.WeakDays</td>
            <td>Phòng</td>
            <td>@Model.DefaultRoom?.Name - Cơ sở @Model.DefaultRoom?.Address</td>
        </tr>
        <tr>
            <td>Điểm danh (buổi)</td>
            <td>3/15</td>
        </tr>
    </table>
</div>

<div class="attendance-section">
    <table class="attendance-table">
        <thead>
            <tr>
                <th>Số buổi</th>
                <th>Thời gian</th>
                <th>Ngày học</th>
                <th>Trạng thái điểm danh</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var buoi in Model.Lessons.OrderBy(x => x.Date).ToList())
            {
                var status = listJoined.FirstOrDefault(x => x.LessonId == buoi.Id);
                if(status != null)
                {
                    
                    <tr class="@(statusDic[status.Status])">
                        <td>@(stt++)</td>
                        <td>
                            @(status.Status != "Có phép" && status.Status != "Không phép" ? status?.JoinTime.ToShortTimeString() : " - ")
                        </td>
                        <td>@buoi.Date?.ToString("dd/MM/yyyy")</td>
                        <td>@statusDisplay[status?.Status ?? ""]</td>
                    </tr>
                }
                else
                {
                    <tr class="default-status">
                        <td>@(stt++)</td>
                        <td>
                             - 
                        </td>
                        <td>@buoi.Date?.ToString("dd/MM/yyyy")</td>
                        <td>Chưa điểm danh</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>




@section Scripts
{

}