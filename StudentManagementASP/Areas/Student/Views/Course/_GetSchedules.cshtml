<div class="events">
    <ul class="wrap">
        <li class="events-group">
            <div class="top-info"><span>Thứ hai</span></div>
            <ul>
                @foreach (var item in Model.Where(x => x.Date.Value.DayOfWeek == DayOfWeek.Monday).ToList())
                {
                    <li class="single-event" data-start="@item.StartLessonNavigation.StartTime.ToString("HH:mm")" data-end="@item.EndLessonNavigation.EndTime.ToString("HH:mm")" data-content="event-abs-circuit" data-event="event-@(stt++)" data-class="@item.CourseClass.StudentClass?.Code" data-code="@item.CourseClass.Code" data-room="@item.Room?.Name" data-teacher="@item.CourseClass.Lecturer?.FullName" data-period="@(item.StartLesson)-@(item.EndLesson)">
                        <a href="">
                            <em class="event-name">@item.CourseClass.Code - @item.CourseClass.Name</em>
                        </a>
                    </li>
                }
            </ul>
        </li>

        <li class="events-group">
            <div class="top-info"><span>Thứ ba</span></div>

            <ul>
                @foreach (var item in Model.Where(x => x.Date.Value.DayOfWeek == DayOfWeek.Tuesday).ToList())
