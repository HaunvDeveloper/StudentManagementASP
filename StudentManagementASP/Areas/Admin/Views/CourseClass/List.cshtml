@model IEnumerable<StudentManagementASP.Models.CourseClass>

@{
    Course course = (Course)ViewBag.Course;
    ViewData["Title"] = "Danh sách lớp học phần " + course.Subject.Name;
}

@section Links {
    <link rel="stylesheet" href="~/assets/css/course.css">
}

<div class="container">
    <div class="table-container m-4">
        <h4 class="text-center mb-4 mt-2" style="font-size:35px;font-weight:bold;">DANH SÁCH LỚP HỌC PHẦN @course.Subject.Name.ToUpper()</h4>
        <div class="d-flex justify-content-between mb-3">
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary">Filters</button>
                <button class="btn btn-outline-secondary">Export</button>
            </div>
            <button data-bs-toggle="modal" data-bs-target="#myModal" class="btn btn-add-course">+ Thêm giảng viên</button>
        </div>

        <table class="table table-bordered table-hover">
            <thead>
                <tr class="table-primary">
                    <th class="text-center text-light">Mã giảng viên</th>
                    <th class="text-center text-light">Họ và tên</th>
                    <th class="text-center text-light">Email</th>
                    <th class="text-center text-light">Ngày sinh</th>
                    <th class="text-center text-light">Giới tính</th>
                    <th class="text-center text-light">Khoa</th>
                    <th width="13%"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        @* <td>@item.Id</td>
                        <td>@item.FullName</td>
                        <td>@item.Email</td>
                        <td>@item.DayOfBirth.ToString("dd/MM/yyyy")</td>
                        <td>@item.LecturerInfos.First().Sex</td>
                        <td>@item.Dept.Name</td>
                        <td class="text-center">
                            <a href="" class="btn-service btn btn-primary mx-1"><img src="~/assets/images/pen-solid.svg" height="20" alt=""></a>
                            <a href="" class="btn-service btn btn-danger"><img src="~/assets/images/trash-solid.svg" height="20" alt=""></a>
                        </td> *@
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>