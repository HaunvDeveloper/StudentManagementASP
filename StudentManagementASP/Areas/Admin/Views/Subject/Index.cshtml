@model StudentManagementASP.ViewModels.SubjectListViewModel

@{
    ViewData["Title"] = "Danh sách các môn học";
    var depts = (IEnumerable<Department>)ViewBag.Depts;
    var selectList = new SelectList(depts, "Id", "Name");
}

@section Links {
    <link rel="stylesheet" href="~/assets/css/course.css">
}

<div class="container">
    <div class="table-container m-4">
        <h4 class="text-center mb-4 mt-2 text-danger" style="font-size:35px;font-weight:bold;">DANH SÁCH MÔN HỌC</h4>
        <div class="d-flex justify-content-between mb-3">
            <div class="d-flex gap-2">
                @Html.DropDownList("DeptId", selectList, "Chọn khoa/bộ môn", new { @class = "form-control", onchange = "onDeptChange()" })
            </div>
            <a asp-action="Create" class="btn btn-add-course">+ Thêm môn học</a>
        </div>

        <table class="table table-bordered table-hover">
            <thead>
                <tr class="table-primary">
                    <th class="text-center text-light">STT</th>
                    <th class="text-center text-light">Mã môn học</th>
                    <th class="text-center text-light">Tên môn học</th>
                    <th class="text-center text-light">Số tín chỉ</th>
                    <th class="text-center text-light">Khóa/Bộ môn</th>
                    <th class="text-center text-light">Số tiết mặc định</th>
                    <th width="13%"></th>
                </tr>
            </thead>
            <tbody>
                @{
                    int stt = 1;
                }
                @foreach (var item in Model.Subjects)
                {
                    <tr>
                        <td>@(stt++)</td>
                        <td>@item.Code</td>
                        <td>@item.Name</td>
                        <td>@item.DefaultCredits</td>
                        <td>@(depts.FirstOrDefault(x => x.Id == item.DeptId)?.Name)</td>
                        <td>@item.DefaultLesson</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-controller="Subject" asp-area="Admin" asp-route-id="@item.Id" class="btn-service btn btn-primary mx-1"><img src="~/assets/images/pen-solid.svg" height="20" alt=""></a>
                            <a asp-action="Delete" asp-controller="Subject" asp-area="Admin" asp-route-id="@item.Id" class="btn-service btn btn-danger"><img src="~/assets/images/trash-solid.svg" height="20" alt=""></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Phân trang -->
        <div class="pag-container middle">
            <div class="pagination">
                <ul>
                    @if (Model.CurrentPage > 1)
                    {
                        <a href="@Url.Action("Index", new { page = Model.CurrentPage - 1 })" class="move previous">
                            <img width="35" height="35" src="~/assets/images/circle-chevron-right-solid.svg" alt="">
                        </a>
                    }
                    else
                    {
                        <a href="#" class="move previous disabled">
                            <img width="35" height="35" src="~/assets/images/circle-chevron-right-solid.svg" alt="">
                        </a>
                    }

                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="@((i == Model.CurrentPage) ? "active" : "")">
                            <a href="@Url.Action("Index", new { page = i })">@i</a>
                        </li>
                    }

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a href="@Url.Action("Index", new { page = Model.CurrentPage + 1 })" class="move next">
                            <img src="~/assets/images/circle-chevron-right-solid.svg" alt="">
                        </a>
                    }
                    else
                    {
                        <a href="#" class="move next disabled">
                            <img src="~/assets/images/circle-chevron-right-solid.svg" alt="">
                        </a>
                    }
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        @if (TempData["Success"] != null)
        {
            <text>
                showToast("success", "Xóa thành công");
            </text>
        }
    </script>
    <script>
        function onDeptChange() {
            const deptId = document.querySelector('[name="DeptId"]').value;
            window.location.href = `@Url.Action("Index")?page=1&deptId=${deptId}`;
        }
        function downloadExcel() {
            const params = {
                DeptId: $('#DeptId').val(),
            };

            $.ajax({
                url: '/Admin/Lecturer/DownloadListLecturer', // Đường dẫn đến action
                method: 'GET',
                data: params,
                xhrFields: {
                    responseType: 'blob' // Đảm bảo nhận dữ liệu dạng binary
                },
                success: function (data, status, xhr) {
                    const blob = new Blob([data], { type: xhr.getResponseHeader('Content-Type') });
                    const downloadUrl = window.URL.createObjectURL(blob);

                    const a = document.createElement('a');
                    a.href = downloadUrl;

                    // Tên file được lấy từ header Content-Disposition
                    const disposition = xhr.getResponseHeader('Content-Disposition');
                    let fileName = 'Download.xlsx';
                    if (disposition && disposition.indexOf('filename=') !== -1) {
                        const matches = /filename="([^"]*)"/.exec(disposition);
                        if (matches != null && matches[1]) fileName = matches[1];
                    }

                    a.download = fileName;
                    document.body.appendChild(a);
                    a.click();

                    // Cleanup
                    document.body.removeChild(a);
                    window.URL.revokeObjectURL(downloadUrl);
                },
                error: function () {
                    alert('Có lỗi xảy ra trong quá trình tải xuống.');
                }
            });
        }
    </script>
}