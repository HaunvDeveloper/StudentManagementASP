@{
    ViewData["Title"] = "Tạo môn học";
}
@model StudentManagementASP.Models.Subject
@section Links {
    <link rel="stylesheet" href="~/assets/css/course.css">
}


<div class="container">
    <form asp-action="Create" asp-controller="Subject" asp-area="Admin" method="post" class="table-container m-4">
        <h4 class="text-center mb-4 mt-2 text-danger" style="font-size:30px;font-weight:bold;">TẠO MÔN HỌC</h4>
        <div class="form-group">
            <label asp-for="Code">Mã môn</label>
            <input asp-for="Code" class="form-control" required/>
        </div>
        <div class="form-group">
            <label asp-for="Name">Tên môn</label>
            <input asp-for="Name" class="form-control" required />
        </div>
        <div class="form-group">
            <label asp-for="DefaultCredits">Số tín chỉ</label>
            <input asp-for="DefaultCredits" class="form-control" required min="1" max="50"/>
        </div>
        <div class="form-group">
            <label asp-for="DefaultLesson">Số tiết dạy mặc định </label>
            <input asp-for="DefaultLesson" class="form-control" required type="number" min="1" max="200">
        </div>
        <div class="form-group">
            <label asp-for="DeptId">Khoa</label>
            @Html.DropDownListFor(x => x.DeptId, (List<SelectListItem>)ViewBag.Depts, new { @class = "select2 form-control", required = "required" })

        </div>
        <div class="text-lg-end mt-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
            <button type="reset" class="btn btn-outline-success">Đặt lại</button>
            <button type="submit" class="btn btn-primary">Tạo</button>
        </div>
        <div class="text-danger mt-2">@ViewBag.Alert</div>
    </form>
</div>

            
@section Scripts {
    <script>
        $('.select2').select2({
            placeholder: "Chọn môn học",
        });
    </script>
}