@model StudentManagementASP.ViewModels.DepartmentViewModel

@{
    ViewData["Title"] = "Danh sách khoa";
}

@section Links {
    <link rel="stylesheet" href="~/assets/css/course.css">
}

<div class="container">
    <div class="table-container m-4">
        <h4 class="text-center mb-4 mt-2" style="font-size:35px;font-weight:bold;">DANH SÁCH KHOA/BỘ MÔN</h4>
        <div class="d-flex justify-content-between mb-3">
            <a asp-action="Create" class="btn btn-add-course">+ Thêm khoa</a>
        </div>

        <table class="table table-bordered table-hover">
            <thead>
                <tr class="table-primary">
                    <th class="text-center text-light">STT</th>
                    <th class="text-center text-light">Mã khoa</th>
                    <th class="text-center text-light">Tên khoa</th>
                    <th width="13%"></th>
                </tr>
            </thead>
            <tbody>
                @{
                    int stt = 1;
                }
                @foreach (var item in Model.Departments)
                {
                    <tr>
                        <td>@(stt++)</td>
                        <td>@item.Code</td>
                        <td>@item.Name</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-controller="Department" asp-area="Admin" asp-route-id="@item.Id" class="btn-service btn btn-primary mx-1"><img src="~/assets/images/pen-solid.svg" height="20" alt=""></a>
                            <a asp-action="Delete" asp-controller="Department" asp-area="Admin" asp-route-id="@item.Id" class="btn-service btn btn-danger"><img src="~/assets/images/trash-solid.svg" height="20" alt=""></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Phân trang -->
        <div class="pag-container middle">
            <div class="pagination">
                <ul>
                    @if (Model.CurrentPage > 1)
                    {
                        <a href="@Url.Action("Index", new { page = Model.CurrentPage - 1 })" class="move previous">
                            <img width="35" height="35" src="~/assets/images/circle-chevron-right-solid.svg" alt="">
                        </a>
                    }
                    else
                    {
                        <a href="#" class="move previous disabled">
                            <img width="35" height="35" src="~/assets/images/circle-chevron-right-solid.svg" alt="">
                        </a>
                    }

                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="@((i == Model.CurrentPage) ? "active" : "")">
                            <a href="@Url.Action("Index", new { page = i })">@i</a>
                        </li>
                    }

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a href="@Url.Action("Index", new { page = Model.CurrentPage + 1 })" class="move next">
                            <img src="~/assets/images/circle-chevron-right-solid.svg" alt="">
                        </a>
                    }
                    else
                    {
                        <a href="#" class="move next disabled">
                            <img src="~/assets/images/circle-chevron-right-solid.svg" alt="">
                        </a>
                    }
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        @if (TempData["Success"] != null)
        {
            <text>
                showToast("success", "@(TempData["Success"])");
            </text>
        }
    </script>
}