@model StudentManagementASP.ViewModels.LecturerListViewModel

@{
    ViewData["Title"] = "Danh sách giảng viên";
}

@section Links {
    <link rel="stylesheet" href="~/assets/css/course.css">
}

<div class="container">
    <div class="table-container m-4">
        <h4 class="text-center mb-4 mt-2 text-danger" style="font-size:35px;font-weight:bold;">DANH SÁCH GIẢNG VIÊN</h4>
        <div class="d-flex justify-content-between mb-3">
            <div class="d-flex gap-2">
                @Html.DropDownList("DeptId", (SelectList)ViewBag.Depts, "Chọn khoa", new { @class = "form-control", onchange = "onDeptChange()" })
                <button onclick="downloadExcel()" class="btn btn-outline-secondary">Export</button>
            </div>
            <button data-bs-toggle="modal" data-bs-target="#myModal" class="btn btn-add-course">+ Thêm giảng viên</button>
        </div>

        <table class="table table-bordered table-hover">
            <thead>
                <tr class="table-primary">
                    <th class="text-center text-light">Mã giảng viên</th>
                    <th class="text-center text-light">Họ và tên</th>
                    <th class="text-center text-light">Email</th>
                    <th class="text-center text-light">Ngày sinh</th>
                    <th class="text-center text-light">Giới tính</th>
                    <th class="text-center text-light">Khoa</th>
                    <th width="13%"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Lecturers)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.FullName</td>
                        <td>@item.Email</td>
                        <td>@item.DayOfBirth.ToString("dd/MM/yyyy")</td>
                        <td>@item.Sex</td>
                        <td>@item.Dept.Name</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-controller="Lecturer" asp-area="Admin" asp-route-id="@item.Id" class="btn-service btn btn-primary mx-1"><img src="~/assets/images/pen-solid.svg" height="20" alt=""></a>
                            <a asp-action="Delete" asp-controller="Lecturer" asp-area="Admin" asp-route-id="@item.Id" class="btn-service btn btn-danger"><img src="~/assets/images/trash-solid.svg" height="20" alt=""></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Phân trang -->
        <div class="pag-container middle">
            <div class="pagination">
                <ul>
                    @if (Model.CurrentPage > 1)
                    {
                        <a href="@Url.Action("Index", new { page = Model.CurrentPage - 1 })" class="move previous">
                            <img width="35" height="35" src="~/assets/images/circle-chevron-left-solid.svg" alt="">
                        </a>
                    }
                    else
                    {
                        <a href="#" class="move previous disabled">
                            <img width="35" height="35" src="~/assets/images/circle-chevron-right-solid.svg" alt="">
                        </a>
                    }

                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="@((i == Model.CurrentPage) ? "active" : "")">
                            <a href="@Url.Action("Index", new { page = i })">@i</a>
                        </li>
                    }

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a href="@Url.Action("Index", new { page = Model.CurrentPage + 1 })" class="move next">
                            <img src="~/assets/images/circle-chevron-right-solid.svg" alt="">
                        </a>
                    }
                    else
                    {
                        <a href="#" class="move next disabled">
                            <img src="~/assets/images/circle-chevron-right-solid.svg" alt="">
                        </a>
                    }
            </div>
        </div>
    </div>
</div>

<div class="modal" id="myModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h4 class="modal-title">Thêm Giảng viên</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body text-center">
                <div class="row">
                    <div class="col-6">
                        <a class="btn btn-lg btn-primary" asp-action="Create" asp-controller="Lecturer" asp-area="Admin">Tạo thủ công</a>
                    </div>
                    <div class="col-6">
                        <a class="btn btn-lg btn-danger" asp-action="CreateWithList" asp-controller="Lecturer" asp-area="Admin">Tải danh sách</a>
                    </div>
                </div>

            </div>


        </div>
    </div>
</div>

@section Scripts {
    <script>
        function onDeptChange() {
            const deptId = document.querySelector('[name="DeptId"]').value;
            const currentPage = @Model.CurrentPage;
            window.location.href = `@Url.Action("Index")?page=${currentPage}&deptId=${deptId}`;
        }
        function downloadExcel() {
            const params = {
                DeptId: $('#DeptId').val(),
            };

            $.ajax({
                url: '/Admin/Lecturer/DownloadListLecturer', // Đường dẫn đến action
                method: 'GET',
                data: params,
                xhrFields: {
                    responseType: 'blob' // Đảm bảo nhận dữ liệu dạng binary
                },
                success: function (data, status, xhr) {
                    const blob = new Blob([data], { type: xhr.getResponseHeader('Content-Type') });
                    const downloadUrl = window.URL.createObjectURL(blob);

                    const a = document.createElement('a');
                    a.href = downloadUrl;

                    // Tên file được lấy từ header Content-Disposition
                    const disposition = xhr.getResponseHeader('Content-Disposition');
                    let fileName = 'Download.xlsx';
                    if (disposition && disposition.indexOf('filename=') !== -1) {
                        const matches = /filename="([^"]*)"/.exec(disposition);
                        if (matches != null && matches[1]) fileName = matches[1];
                    }

                    a.download = fileName;
                    document.body.appendChild(a);
                    a.click();

                    // Cleanup
                    document.body.removeChild(a);
                    window.URL.revokeObjectURL(downloadUrl);
                },
                error: function () {
                    alert('Có lỗi xảy ra trong quá trình tải xuống.');
                }
            });
        }
    </script>
}