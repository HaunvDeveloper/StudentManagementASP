@{
    ViewData["Title"] = "Danh sách sinh viên";
}

@section Links {
    <link rel="stylesheet" href="~/assets/css/course.css">
}

<div class="container">
    <div class="table-container m-4">
        <h4 class="text-center mb-4 mt-2 text-danger" style="font-size:30px;font-weight:bold;">DANH SÁCH SINH VIÊN</h4>
        <div class="d-flex justify-content-between mb-3 align-items-center flex-wrap gap-2">
            <div>
                <div class="d-flex gap-2 align-items-center w-100">
                    <span style="text-wrap: nowrap;">Chọn khóa:</span>
                    @Html.DropDownList("StudyYearId", (SelectList)ViewBag.StudyYear, "Tất cả", new { @class = "form-control", id = "StudyYearId" })
                    
                    <span style="text-wrap: nowrap;">Chọn khoa:</span>
                    @Html.DropDownList("DeptId", (SelectList)ViewBag.Dept, "Tất cả", new { @class = "form-control", id = "DeptId" })

                    <span style="text-wrap: nowrap;">Chọn ngành:</span>
                    <select id="SpecializationId" class="form-control" disabled>
                        <option value="">Chọn ngành</option>
                    </select>
                </div>
                <div class="d-flex gap-2 mt-4 align-items-center">
                    <span style="text-wrap: nowrap;">Tìm kiếm:</span>
                    <input type="text" name="keyword" id="keyword" class="form-control" placeholder="Nhập nội dung tìm kiếm.... "/>
                    <button id="btn-search" onclick="search(1)" class="btn btn-primary">LỌC</button>
                </div>
            </div>
                <button class="btn btn-outline-secondary" onclick="downloadExcel()">Export</button>
                <a asp-action="CreateWithList" asp-controller="Student" asp-area="Admin" class="btn btn-add-course">+ Thêm sinh viên</a>
        </div>

        <div class="table-data table-responsive">
            <!-- Nội dung bảng danh sách sinh viên sẽ được hiển thị ở đây -->
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function downloadExcel() {
            const params = {
                StudyYearId: $('#StudyYearId').val(),
                DeptId: $('#DeptId').val(),
                SpecializationId: $('#SpecializationId').val()
            };

            $.ajax({
                url: '/Admin/Student/DownloadListStudent', // Đường dẫn đến action
                method: 'GET',
                data: params,
                xhrFields: {
                    responseType: 'blob' // Đảm bảo nhận dữ liệu dạng binary
                },
                success: function (data, status, xhr) {
                    const blob = new Blob([data], { type: xhr.getResponseHeader('Content-Type') });
                    const downloadUrl = window.URL.createObjectURL(blob);

                    const a = document.createElement('a');
                    a.href = downloadUrl;

                    // Tên file được lấy từ header Content-Disposition
                    const disposition = xhr.getResponseHeader('Content-Disposition');
                    let fileName = 'Download.xlsx';
                    if (disposition && disposition.indexOf('filename=') !== -1) {
                        const matches = /filename="([^"]*)"/.exec(disposition);
                        if (matches != null && matches[1]) fileName = matches[1];
                    }

                    a.download = fileName;
                    document.body.appendChild(a);
                    a.click();

                    // Cleanup
                    document.body.removeChild(a);
                    window.URL.revokeObjectURL(downloadUrl);
                },
                error: function () {
                    alert('Có lỗi xảy ra trong quá trình tải xuống.');
                }
            });
        }
        function search(p) {
            let data = {
                StudyYearId: $('#StudyYearId').val(),
                DeptId: $('#DeptId').val(),
                SpecializationId: $('#SpecializationId').val(),
                keyword: $('#keyword').val(),
                p: p
            }
            $.ajax({
                url: '@Url.Action("_GetList", "Student", new { area = "Admin" })',
                method: 'POST',
                data: data,
                success: function (response) {
                    $('.table-data').html(response);
                    attachPaginationEvents();
                }
            });
        }


        function attachPaginationEvents() {
            $('.pagination a').off('click').on('click', function (e) {
                e.preventDefault();
                var page = $(this).data('page');
                search(page);
            });
        }
        $(document).ready(function() {
            
            search(1);

            $('#DeptId').on('change', function() {
                var deptId = $(this).val();

                if (deptId) {
                    var specializationSelect = $('#SpecializationId');
                    specializationSelect.empty();
                    specializationSelect.append('<option value="">Chọn ngành</option>');
                    $.ajax({
                        url: '/api/API/GetSpecializationByDept?deptid=' + deptId,
                        type: 'POST',
                        success: function(data) {
                            if (data && data.length > 0) {
                                $.each(data, function(index, spec) {
                                    specializationSelect.append('<option value="' + spec.id + '">' + spec.name + '</option>');
                                });

                                specializationSelect.prop('disabled', false);  // Kích hoạt dropdown Chọn ngành
                            } else {
                                $('#SpecializationId').prop('disabled', true);  // Nếu không có ngành thì disable dropdown
                            }
                        },
                        error: function() {
                            alert('Không thể lấy dữ liệu ngành.');
                        }
                    });
                } else {
                    $('#SpecializationId').prop('disabled', true);  // Nếu không chọn khoa thì disable dropdown Chọn ngành
                }
            });
        });
        
    </script>
}
