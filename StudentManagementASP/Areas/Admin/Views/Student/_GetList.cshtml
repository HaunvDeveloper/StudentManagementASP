@model IEnumerable<StudentManagementASP.Models.Student>

@{
    int CurrentPage = (int)ViewBag.CurrentPage;
    int TotalPages = (int)ViewBag.TotalPages;
}

<table id="table-student" class="table table-bordered table-hover">
    <thead>
        <tr class="table-primary">
            <th class="text-center text-light">Mã số sinh viên</th>
            <th class="text-center text-light">Họ và tên</th>
            <th class="text-center text-light">Email</th>
            <th class="text-center text-light">Ngày sinh</th>
            <th class="text-center text-light">Ngành</th>
            <th class="text-center text-light">Khoa</th>
            <th width="13%"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.FullName</td>
                <td>@item.Email</td>
                <td>@item.DayOfBirth.ToString("dd/MM/yyyy")</td>
                <td>@item.Curriculum.Name</td>
                <td>@item.Dept.Name</td>
                <td class="text-center">
                    <a href="" class="btn-service btn btn-primary mx-1"><img src="~/assets/images/pen-solid.svg" height="20" alt=""></a>
                    <a href="" class="btn-service btn btn-danger"><img src="~/assets/images/trash-solid.svg" height="20" alt=""></a>
                </td>
            </tr>
        }
    </tbody>
</table>


<!-- Phân trang -->
<div class="pag-container middle">
    <div class="pagination">
        <ul>
            @if (CurrentPage > 1)
            {
                <a href="#" data-page="@(CurrentPage-1)" class="move previous">
                    <img width="35" height="35" src="~/assets/images/circle-chevron-right-solid.svg" alt="">
                </a>
            }
            else
            {
                <a href="#" class="move previous disabled">
                    <img width="35" height="35" src="~/assets/images/circle-chevron-right-solid.svg" alt="">
                </a>
            }

            @for (var i = 1; i <= TotalPages; i++)
            {
                <li class="@((i == CurrentPage) ? "active" : "")">
                    <a href="#" data-page="@i">@i</a>
                </li>
            }

            @if (CurrentPage < TotalPages)
            {
                <a href="#" data-page="@(CurrentPage + 1)" class="move next">
                    <img src="~/assets/images/circle-chevron-right-solid.svg" alt="">
                </a>
            }
            else
            {
                <a href="#" class="move next disabled">
                    <img src="~/assets/images/circle-chevron-right-solid.svg" alt="">
                </a>
            }
    </div>
</div>