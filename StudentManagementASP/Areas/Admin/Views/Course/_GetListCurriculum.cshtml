@{
    
    int stt = 1;
    List<StudyYearDetail> listYear = (List<StudyYearDetail>)ViewBag.ListYear;
}
@model StudentManagementASP.Models.Curriculum


<table class="table table-hover table-bordered">
    <thead class="table-primary">
        <tr>
            <th>STT</th>
            <th>Mã học phần</th>
            <th>Tên học phần</th>
            <th>STC</th>
            <th>Số Tiết</th>
            <th>Loại HP</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var year in listYear)
        {
            <tr class="table-success">
                <td colspan="7">Năm học @year.StartYear - @year.EndYear</td>
            </tr>
            foreach (var hk in year.Semesters)
            {
                <tr class="table-secondary">
                    <td colspan="7">@hk.Name</td>
                </tr>
                foreach (var course in Model.Courses.Where(x => x.SemesterId == hk.Id))
                {
                    <tr>
                        <td>@stt</td>
                        <td>@course.Subject.Code</td>
                        <td>@course.Subject.Name</td>
                        <td>@course.Credits</td>
                        <td>@course.Lesson</td>
                        <td>@course.Type.Name</td>
                        <td>
                            <a asp-action="GetClassBySubject" asp-controller="CourseClass" asp-area="Admin" asp-route-subjectId="@course.Subject.Id">Xem lớp học phần</a>
                        </td>
                    </tr>
                    stt++;
                }
            }
        }
    </tbody>
</table>
