@{
    ViewData["Title"] = "Danh sách học phần";
}

@section Links {
    <link rel="stylesheet" href="~/assets/css/course.css">
}

<div class="container">
    <div class="table-container m-4">
        <h4 class="text-center mb-4 mt-2 text-danger" style="font-size:30px;font-weight:bold;">DANH SÁCH HỌC PHẦN</h4>
        <div class="d-flex justify-content-between mb-3 align-items-center flex-wrap gap-2">
            <div>
                <div class="d-flex gap-2 align-items-center w-100">
                    <span style="text-wrap: nowrap;">Chọn khóa:</span>
                    @Html.DropDownList("StudyYearId", (SelectList)ViewBag.StudyYear, new { @class = "form-control", id = "StudyYearId" })

                    <span style="text-wrap: nowrap;">Chọn chương trình đào tạo:</span>

                    <select id="CurriculumId" class="form-control" disabled>
                        <option value="">Chọn Chương trình đào tạo</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="table-data">
            <!-- Nội dung bảng danh sách sinh viên sẽ được hiển thị ở đây -->
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            

            $('#StudyYearId').on('change', function () {
                var yearId = $(this).val();
                $('.table-data').html("Hãy chọn chương trình đào tạo");
                if (yearId) {
                    $.ajax({
                        url: '/api/API/GetCurriculumByYearId?yearId=' + yearId,
                        type: 'POST',
                        success: function (data) {
                            if (data && data.length > 0) {
                                var curriculumSelect = $('#CurriculumId');
                                curriculumSelect.empty();
                                curriculumSelect.append('<option value="">Chọn Chương trình đào tạo</option>');

                                $.each(data, function (index, item) {
                                    curriculumSelect.append('<option value="' + item.id + '">' + item.name + '</option>');
                                });

                                curriculumSelect.prop('disabled', false);  // Kích hoạt dropdown Chọn ngành
                            } else {
                                $('#CurriculumId').prop('disabled', true);  // Nếu không có ngành thì disable dropdown
                            }
                        },
                        error: function () {
                            alert('Không thể lấy dữ liệu ngành.');
                        }
                    });
                } else {
                    $('#CurriculumId').prop('disabled', true);  // Nếu không chọn khoa thì disable dropdown Chọn ngành
                }
            });

            $('#CurriculumId').on('change', function () {
                var currId = $(this).val();
                if(currId){
                    $.ajax({
                        url: '@Url.Action("_GetListCurriculum", "Course", new{area="Admin"})',
                        data: { CurriculumId: currId },
                        type: 'GET',
                        success: function (response) {
                            $('.table-data').html(response);
                        },
                        error: function (err) {
                            $('.table-data').html(err);
                        }
                    })
                }
            });
            $('#StudyYearId').trigger('change');

        });
        
    </script>
}
