@{
    ViewData["Title"] = "Xóa chương trình đào tạo";
}
@model StudentManagementASP.Models.Curriculum
@section Links {
    <link rel="stylesheet" href="~/assets/css/course.css">
    <style>
        .form-group {
            display: flex;
            flex-direction: column;
        }

        .displayModel {
            font-size: 18px;
            font-weight: bold;
        }
    </style>
}


<div class="container">
    <form asp-action="DeleteConfirmed" asp-controller="Curriculum" asp-area="Admin" method="post" class="table-container m-4">
        <h4 class="text-center mb-4 mt-2 text-danger" style="font-size:30px;font-weight:bold;">XÓA CHƯƠNG TRÌNH ĐÀO TẠO</h4>
        <input asp-for="Id" type="hidden"/>
        <div class="form-group">
            <label asp-for="Code">Mã chương trình</label>
            <input disabled asp-for="Code" class="form-control"  />
        </div>
        <div class="form-group">
            <label asp-for="Name">Tên chương trình</label>
            <input disabled asp-for="Name" class="form-control"  />
        </div>
        <div class="form-group">
            <label asp-for="StudyYearId">Khóa</label>
            <input disabled class="form-control" value="@Model.StudyYear.Number"/>
        </div>
        <div class="form-group">
            <label asp-for="MajorId">Ngành</label>
            <input disabled class="form-control" value="@Model.Major.Name" />
        </div>
        <div class="text-lg-end mt-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
            <button type="submit" class="btn btn-primary btn-danger">Xoá</button>
        </div>
        <div class="text-danger mt-2">@ViewBag.Alert</div>
    </form>
</div>