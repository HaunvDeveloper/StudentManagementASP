@{
	ViewData["Title"] = "Thông tin giảng viên";
}

@section Links {
	<link rel="stylesheet" href="~/assets/css/lecturerDashboard.css">
}

<div class="container mt-5">
	<h4 class="text-left mb-4">Thông tin giảng viên</h4>
	<div class="row">
		<div class="col-md-3">
			<div class="card mb-3">
				<div class="card-body text-center">
					<img src="https://via.placeholder.com/150" class="rounded-circle mb-3" alt="Avatar">
				</div>
			</div>
			<div class="card">
				<div class="card-body">
					<h5 class="card-title">Thông tin cá nhân</h5>
					<p><strong>Mã giảng viên:</strong> 9112</p>
					<p><strong>Họ tên:</strong> Nguyễn Duy Hàm</p>
					<p><strong>Giới tính:</strong> Nam</p>
					<p><strong>Email:</strong> example@example.com</p>
					<p><strong>Địa chỉ thường trú:</strong> 123 Đường ABC, Hà Nội</p>
					<p><strong>Địa chỉ liên lạc:</strong> 456 Đường XYZ, Hà Nội</p>
				</div>
			</div>
		</div>

		<div class="col-md-9">
			<div class="card">
				<div class="card-body">
					<h5 class="card-title">Thông tin cơ bản</h5>
					<div class="row">
						<div class="col-md-6">
							<p><strong>CMND/CCCD:</strong> 123456789</p>
							<p><strong>Ngày cấp:</strong> 01/01/2020</p>
							<p><strong>Nơi cấp:</strong> Hà Nội</p>
							<p><strong>Điện thoại:</strong> 0987654321</p>
						</div>
						<div class="col-md-6">
							<p><strong>Ngày sinh:</strong> 01/01/1990</p>
							<p><strong>Nơi sinh:</strong> Hà Nội</p>
							<p><strong>Dân tộc:</strong> Kinh</p>
							<p><strong>Tôn giáo:</strong> Không</p>
						</div>
					</div>

					<h5 class="card-title">Thông tin chức vụ</h5>
					<div class="row">
						<div class="col-md-6">
							<p><strong>Học hàm:</strong> Giảng viên</p>
							<p><strong>Học vị:</strong> Tiến sĩ</p>
							<p><strong>Chức vụ:</strong> </p>
						</div>
						<div class="col-md-6">
							<p><strong>Loại giảng viên:</strong> Hợp đồng thỉnh giảng</p>
							<p><strong>Chuyên ngành:</strong> Công nghệ thông tin</p>
							<p><strong>Khoa:</strong> Khoa Công nghệ Thông tin</p>
						</div>
					</div>

					<h5 class="card-title">Thông tin ngân hàng</h5>
					<div class="row">
						<div class="col-md-6">
							<p><strong>Số tài khoản:</strong> 1234567890</p>
							<p><strong>Mã số thuế:</strong> 123456789</p>
						</div>
						<div class="col-md-6">
							<p><strong>Tên ngân hàng:</strong> Vietcombank</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts
{

}