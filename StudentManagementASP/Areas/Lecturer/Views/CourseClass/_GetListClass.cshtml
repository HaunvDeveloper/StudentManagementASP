@model IEnumerable<StudentManagementASP.Models.CourseClass>

@{
    ViewData["Title"] = "Danh sách lớp học phần";
    string[] dayNames = new string[] { "Chủ Nhật", "Thứ Hai", "Thứ Ba", "Thứ Tư", "Thứ Năm", "Thứ Sáu", "Thứ Bảy" };
}

@section Links {
    <link rel="stylesheet" href="~/assets/css/course.css">
}



<table class="table table-bordered table-hover">
    <thead>
        <tr class="table-primary">
            <th class="text-center text-light">Mã lớp học phần</th>
            <th class="text-center text-light">Tên lớp học phần</th>
            <th class="text-center text-light">Lớp sinh viên</th>
            <th class="text-center text-light">Sĩ số</th>
            <th class="text-center text-light">Thời khóa biểu</th>
            <th class="text-center text-light">Ngày bắt đầu</th>
            <th class="text-center text-light">Ngày kết thúc</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Code</td>
                <td>@item.Name</td>
                <td>@item.StudentClass?.Code</td>
                <td>@item.StudentJoinClasses.Count</td>
                <td>@item.WeakDays</td>
                <td>@(item.StartDate.ToString("dd/MM/yyyy"))</td>
                <td>@(item.EndDate.ToString("dd/MM/yyyy"))</td>
                <td class="text-center" style="text-wrap:nowrap;">
                    <a asp-action="ViewStudentList" asp-route-id="@item.Id" class="btn-service btn btn-info mx-1"><img src="~/assets/images/bars-solid.svg" height="20" alt=""></a>
                    <a asp-action="ExportStudentList" asp-route-id="@item.Id" class="btn-service btn btn-warning"><img src="~/assets/images/file-export-solid.svg" height="20" alt=""></a>
                </td>
            </tr>
        }
    </tbody>
</table>