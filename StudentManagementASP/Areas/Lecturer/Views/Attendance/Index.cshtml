@{
    ViewData["Title"] = "Điểm danh online";
}

@section Links {
    <link rel="stylesheet" href="~/assets/css/course.css">
    <link rel="stylesheet" href="~/assets/css/checkbox.css">
    <style>
        .form-control-sm{
            outline:none;
            border:none;
        }
    </style>
}

<div class="container">
    <div class="table-container m-4">
        <h4 class="text-center mb-4 mt-2 text-danger" style="font-size:30px;font-weight:bold;">ĐIỂM DANH LỚP HỌC PHẦN</h4>
        <div class="d-flex justify-content-between mb-3 align-items-center flex-wrap gap-2">
            <div>
                <div class="d-flex gap-2 flex-wrap align-items-center w-100">
                    <div>
                        <span style="text-wrap: nowrap;">Chọn niên học:</span>
                        @Html.DropDownList("StudyYearDetailId", (SelectList)ViewBag.StudyYearDetails, new { @class = "form-control " })
                    </div>
                    
                    <div>
                        <span style="text-wrap: nowrap;">Học kỳ:</span>
                        <select id="SemesterId" name="SemesterId" class="form-control" required>
                            <option value="">Chọn học kỳ</option>
                        </select>
                    </div>
                    
                    <div>
                        <span style="text-wrap: nowrap;">Lớp học phần:</span>
                        <select id="CourseClassId" name="CourseClassId" class="form-control" required>
                        </select>
                    </div>

                    <div>
                        <span style="text-wrap: nowrap;">Buổi học:</span>
                        <select id="LessonId" name="LessonId" class="form-control" required>
                        </select>
                    </div>
                    
                     <button class="activate mt-4 btn btn-info">Kích hoạt chức năng điểm danh</button>
                    
                </div>
                
            </div>
            <div></div>
        </div>

        <div class="table-data table-responsive">
            <!-- Nội dung bảng danh sách sinh viên sẽ được hiển thị ở đây -->
        </div>
        <div class="text-lg-end">
            <button id="save" class="btn btn-primary">LƯU</button>
        </div>
    </div>
</div>




@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.0/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/attendanceHub")
            .build();

        connection.on("ReceiveAttendance", function (studentId, status) {
            showToast("success", "Đã điểm danh " + studentId);
            console.log("Student ID:", studentId, "Status:", status);

            // Tìm hàng chứa studentId
            const row = $(`tr[data-id="${studentId}"]`);
            console.log(row.length > 0 ? "Row found" : "Row not found");

            if (row.length > 0) {
                // Tìm checkbox bên trong row
                const checkbox = row.find('input[type=checkbox][value="'+status+'"]');
                console.log(checkbox.length > 0 ? "Checkbox found" : "Checkbox not found");

                if (checkbox.length > 0) {
                    checkbox.focus();
                    checkbox.prop('checked', true); // Sử dụng prop thay vì .checked
                }
            }
        });


        connection.start().catch(err => console.error(err));
    </script>
    <script>
        $(document).ready(function () {
            $('.activate').on('click', function () {
                var isActive = $('.activate').hasClass('btn-info');
                $.ajax({
                    url: '@Url.Action("ActivateDevice", "Attendance", new { area = "Lecturer" })',
                    method: 'post',
                    data: { active: isActive, lessonId: $('#LessonId').val() },
                    success: function (response) {
                        if (response.success) {
                            
                            
                            if (!isActive) {
                                showAlert("success", "Tắt thành công");
                                $('.activate').text('Kích hoạt chức năng điểm danh');
                                $('.activate').addClass('btn-info');
                                $('.activate').removeClass('btn-danger');
                            }
                            else {
                                showAlert("success", "Kích hoạt thành công");
                                $('.activate').text('Tắt thiết bị');

                                $('.activate').removeClass('btn-info');
                                $('.activate').addClass('btn-danger');
                            }
                        } else {
                            showAlert("error", "Kích hoạt thất bại", response.error);
                        }
                    },
                    error: function (error) {
                        showAlert("error", "Kích hoạt thất bại", response.error);
                    }
                });
            });
            $('#save').on('click', function () {
                var list = [];
                $('.row-student').each(function (index, element) {
                    var ob = {
                        StudentId: $(element).attr('data-id'),
                        LessonId: $('#LessonId').val(),
                        Status: $(element).find('input[type=checkbox]:checked').val() || "Có mặt",
                        LateLessons: $(element).find('.lateLesson').val(),
                        Description: $(element).find('.description').val()
                    }
                    list.push(ob);
                });
                $.ajax({
                    url: '@Url.Action("Save", "Attendance", new {area="Lecturer"})',
                    method: 'post',
                    data: { list },
                    success: function (response) {
                        if (response.success) {
                            showAlert("success", "Lưu thành công");
                        } else {
                            showAlert("error", "Lưu thất bại");
                        }
                    },
                    error: function (error) {
                        showAlert("error", "Lưu thất bại");
                    }
                });
            });


            $(document).on('change', 'input[type=checkbox]', function () {
                // Lấy giá trị `name` của checkbox hiện tại
                var name = $(this).attr('name');

                // Nếu checkbox này được chọn
                if ($(this).is(':checked')) {
                    // Bỏ chọn tất cả các checkbox khác có cùng giá trị `name`
                    $('input[type=checkbox][name="' + name + '"]').not(this).prop('checked', false);

                    // Kiểm tra giá trị checkbox
                    if ($(this).val() === "Đi trễ") {
                        // Kích hoạt lại input có class `.lateLesson`
                        $(this).closest('tr').find('.lateLesson').prop('disabled', false);
                    } else {
                        // Vô hiệu hóa input có class `.lateLesson`
                        $(this).closest('tr').find('.lateLesson').prop('disabled', true);
                    }
                } else {
                    $(this).closest('tr').find('.lateLesson').prop('disabled', true);
                    $(this).closest('tr').find('.lateLesson').val('');
                }
            });


            $('#LessonId').on('change', function () {
                $('.table-data').html('');
                $.ajax({
                    url: '@Url.Action("_GetListStudent", "Attendance", new { area = "Lecturer" })',
                    method: 'get',
                    data: { classId: $('#CourseClassId').val(), lessonId: $('#LessonId').val() },
                    success: function (response) {
                        $('.table-data').html(response);
                    },
                    error: function (err) {
                        $('.table-data').html(err);

                    }
                })
            });


            $('#CourseClassId').on('change', function () {
                $('.table-data').html('');
                $.ajax({
                    url: '@Url.Action("GetLessonAPI", "Attendance", new { area = "Lecturer" })',
                    method: 'get',
                    data: { classId: $('#CourseClassId').val() },
                    success: function (data) {
                        if (data && data.length > 0) {
                            var curriculumSelect = $('#LessonId');
                            curriculumSelect.empty();

                            $.each(data, function (index, item) {
                                curriculumSelect.append('<option value="' + item.id + '">' + item.name + '</option>');
                            });
                            $('#LessonId').trigger('change');

                        } else {
                            $('#LessonId').empty();
                            $('#LessonId').trigger('change');
                        }
                    },
                    error: function (err) {
                        $('.table-data').html(err);

                    }
                })
            });

            $('#SemesterId').on('change', function () {
                $('.table-data').html('');
                $.ajax({
                    url: '@Url.Action("GetListClassAPI", "Attendance", new { area = "Lecturer" })',
                    method: 'get',
                    data: { semesterId: $('#SemesterId').val() },
                    success: function (data) {
                        if (data && data.length > 0) {
                            var curriculumSelect = $('#CourseClassId');
                            curriculumSelect.empty();

                            $.each(data, function (index, item) {
                                curriculumSelect.append('<option value="' + item.id + '">' + item.name + '</option>');
                            });
                            $('#CourseClassId').trigger('change');

                        } else {
                            $('#CourseClassId').empty();
                            $('#CourseClassId').trigger('change');
                        }
                    },
                    error: function (err) {
                        $('.table-data').html(err);

                    }
                })
            });

            $('#StudyYearDetailId').on('change', function () {
                var yearId = $(this).val();
                if (yearId) {
                    $.ajax({
                        url: '/api/API/GetSemesterByYearDetail?yearDetailId=' + yearId,
                        type: 'GET',
                        success: function (data) {
                            if (data && data.length > 0) {
                                var curriculumSelect = $('#SemesterId');
                                curriculumSelect.empty();

                                var now = new Date(); // Ngày hiện tại

                                $.each(data, function (index, item) {
                                    var startDate = new Date(item.startDate);
                                    var endDate = new Date(item.endDate);

                                    // Kiểm tra ngày hiện tại thuộc khoảng [startDate, endDate]
                                    var isSelected = now >= startDate && now <= endDate ? ' selected' : '';

                                    curriculumSelect.append('<option value="' + item.id + '"' + isSelected + '>' + item.name + '</option>');
                                });
                                $('#SemesterId').trigger('change');

                            } else {
                                $('#SemesterId').empty();
                                $('#SemesterId').trigger('change');
                            }
                        },
                        error: function () {
                            alert('Không thể lấy dữ liệu.');
                        }
                    });
                }
                $('#SemesterId').trigger('change');
            });
            $('#StudyYearDetailId').trigger('change');
        });

    </script>
}
